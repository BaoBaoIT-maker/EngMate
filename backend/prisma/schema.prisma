datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. NHÓM NGƯỜI DÙNG & TÀI KHOẢN (IDENTITY)
// ==========================================

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique @db.VarChar(100)
  passwordHash  String?        @map("password_hash") @db.VarChar(255)
  role          Role           @default(USER)
  isVerified    Boolean        @default(false) @map("is_verified")
  verifiedAt    DateTime?      @map("verified_at")

  // Auth bên thứ 3 (Google, Facebook)
  provider      AuthProvider   @default(LOCAL)
  providerId    String?        @map("provider_id") @db.VarChar(255)

  isBanned      Boolean        @default(false) @map("is_banned")
  bannedAt      DateTime?      @map("banned_at")

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Quan hệ 1-1 (Tách bảng để tối ưu hiệu suất)
  profile         UserProfile?
  setting         UserSetting?
  skill           UserSkill?
  subscription    UserSubscription?

  // Quan hệ 1-Nhiều
  flashcards      Flashcard[]
  chatSessions    ChatSession[]
  transactions    Transaction[]
  learningPaths   UserLearningPath[]

  @@map("users")
}

model UserProfile {
  userId        Int            @id @map("user_id")
  username      String         @db.VarChar(50)
  avatarUrl     String?        @map("avatar_url") @db.Text
  bio           String?        @db.Text
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSetting {
  userId          Int            @id @map("user_id")
  theme           ThemeMode      @default(LIGHT)
  receiveEmails   Boolean        @default(true)  @map("receive_emails")
  dailyWordGoal   Int            @default(15)    @map("daily_word_goal")
  onboardingDone  Boolean        @default(false) @map("onboarding_done")

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserSkill {
  userId          Int            @id @map("user_id")
  currentLevel    EnglishLevel   @default(A1) @map("current_level")
  vocabularyScore Int            @default(0) @map("vocabulary_score")
  grammarScore    Int            @default(0) @map("grammar_score")
  speakingScore   Int            @default(0) @map("speaking_score")

  streakDays      Int            @default(0) @map("streak_days")
  maxStreak       Int            @default(0) @map("max_streak")
  totalExp        Int            @default(0) @map("total_exp")
  lastActiveDate  DateTime?      @map("last_active_date")

  aiChatCountToday Int           @default(0) @map("ai_chat_count_today")
  lastAiChatDate   DateTime?     @map("last_ai_chat_date")

  updatedAt       DateTime       @updatedAt @map("updated_at")

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_skills")
}

model SubscriptionPlan {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  code         String   @unique @db.VarChar(50)
  price        Int
  durationDays Int      @map("duration_days")
  features     Json
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  userId         Int          @id @map("user_id")
  planId         Int          @map("plan_id")
  startDate      DateTime     @default(now()) @map("start_date")
  endDate        DateTime?    @map("end_date")
  isValid        Boolean      @default(true) @map("is_valid")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("user_subscriptions")
}

// 1 user có thể học nhiều khóa cùng lúc, mỗi khóa có trình độ và mục tiêu riêng
model UserLearningPath {
  id            Int          @id @default(autoincrement())
  userId        Int          @map("user_id")
  // Lưu code của Category (VD: "GENERAL", "TOEIC", "IELTS")
  // Dùng String thay vì FK để tránh JOIN và linh hoạt khi thêm category mới
  categoryCode  String       @map("category_code") @db.VarChar(50)
  currentLevel  String       @default("A1") @map("current_level") @db.VarChar(50)
  targetScore   String?      @map("target_score") @db.VarChar(50)
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryCode])
  @@map("user_learning_paths")
}

// ==========================================
// 2. NHÓM DANH MỤC KHÓA HỌC (DYNAMIC)
// ==========================================

// Bảng Category động — Admin có thể thêm/sửa/ẩn mà không cần migration
model Category {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)  // "GENERAL", "TOEIC", "IELTS", ...
  name        String   @db.VarChar(100)          // "Giao tiếp chung", "Luyện thi TOEIC", ...
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("categories")
}

// ==========================================
// 3. NHÓM HỌC TẬP & TỪ VỰNG (CONTENT & SM-2)
// ==========================================

model VocabularyTopic {
  id           Int              @id @default(autoincrement())
  name         String           @unique @db.VarChar(100)
  description  String?          @db.Text
  categoryCode String           @default("GENERAL") @map("category_code") @db.VarChar(50)
  level        EnglishLevel     @default(B1)
  isPremium    Boolean          @default(false) @map("is_premium")
  wordCount    Int              @default(0) @map("word_count")
  thumbnailUrl String?          @map("thumbnail_url") @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")

  vocabularies SystemVocabulary[]

  @@map("vocabulary_topics")
}

model SystemVocabulary {
  id                 Int               @id @default(autoincrement())
  topicId            Int?              @map("topic_id")
  word               String            @db.VarChar(100)
  type               String            @db.VarChar(20)
  phonetic           String            @db.VarChar(100)
  definitionText     String            @map("definition_text") @db.Text
  vietnameseMeaning  String            @map("vietnamese_meaning") @db.Text
  exampleJson        Json              @map("example_json")
  categoryCode       String            @default("GENERAL") @map("category_code") @db.VarChar(50)
  level              EnglishLevel      @default(B1)

  topic              VocabularyTopic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  flashcards         Flashcard[]

  @@map("system_vocabulary")
}

model Flashcard {
  id                 Int               @id @default(autoincrement())
  userId             Int               @map("user_id")
  systemVocabularyId Int?              @map("system_vocabulary_id")

  customWord         String?           @map("custom_word") @db.VarChar(100)
  customMeaning      String?           @map("custom_meaning") @db.VarChar(255)
  customDefinition   String?           @map("custom_definition") @db.Text
  customPhonetic     String?           @map("custom_phonetic") @db.VarChar(100)
  customExamples     Json?             @map("custom_examples")

  createdAt          DateTime          @default(now()) @map("created_at")

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemVocabulary   SystemVocabulary? @relation(fields: [systemVocabularyId], references: [id], onDelete: SetNull)
  progress           StudyProgress?
  reviewLogs         ReviewLog[]

  @@map("flashcards")
}

model StudyProgress {
  flashcardId        Int               @id @map("flashcard_id")
  boxLevel           Int               @default(1) @map("box_level")
  easinessFactor     Float             @default(2.5) @map("easiness_factor")
  repetitions        Int               @default(0)
  interval           Int               @default(0)
  nextReviewDate     DateTime          @default(now()) @map("next_review_date")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  flashcard          Flashcard         @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@map("study_progresses")
}

model ReviewLog {
  id              Int          @id @default(autoincrement())
  flashcardId     Int          @map("flashcard_id")
  // String thay cho GameType enum — linh hoạt khi thêm game mới
  gameType        String       @map("game_type") @db.VarChar(50)
  qualityRating   Int          @map("quality_rating")
  isCorrect       Boolean      @map("is_correct")
  createdAt       DateTime     @default(now()) @map("created_at")

  flashcard       Flashcard    @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@map("review_logs")
}

// ==========================================
// 4. NHÓM AI COACHING & LUYỆN NÓI
// ==========================================

model ChatSession {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  topic          String       @db.VarChar(255)
  categoryCode   String       @default("GENERAL") @map("category_code") @db.VarChar(50)
  targetLevel    EnglishLevel @map("target_level")
  aiFeedback     Json?        @map("ai_feedback")
  createdAt      DateTime     @default(now()) @map("created_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id             Int          @id @default(autoincrement())
  sessionId      Int          @map("session_id")
  senderRole     SenderRole   @map("sender_role")
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  session        ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ==========================================
// 5. NHÓM THANH TOÁN (SEPAY)
// ==========================================

model Transaction {
  id              Int               @id @default(autoincrement())
  userId          Int               @map("user_id")

  sepayTranId     String            @unique @map("sepay_tran_id") @db.VarChar(100)
  amount          Decimal           @db.Decimal(10, 2)
  code            String            @unique @db.VarChar(50)
  gateway         String            @db.VarChar(50)
  transactionDate DateTime          @map("transaction_date")
  status          TransactionStatus @default(PENDING)

  createdAt       DateTime          @default(now()) @map("created_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

// ==========================================
// 6. NHÓM GAME CONFIG (DYNAMIC)
// ==========================================

// Bảng GameConfig động — Admin bật/tắt game, thêm game mới chỉ cần thêm record
model GameConfig {
  id        Int      @id @default(autoincrement())
  // String thay cho GameType enum — không cần migration khi thêm game
  gameType  String   @unique @map("game_type") @db.VarChar(50)
  isEnabled Boolean  @default(true) @map("is_enabled")
  label     String   @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("game_configs")
}

// ==========================================
// 7. CÁC KIỂU DỮ LIỆU ENUM (CHỈ GIỮ CÁI THỰC SỰ ỔN ĐỊNH)
// ==========================================

enum Role {
  ADMIN
  USER
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

enum ThemeMode {
  LIGHT
  DARK
}

// Giữ lại EnglishLevel vì đây là chuẩn CEFR quốc tế — rất ổn định
enum EnglishLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SenderRole {
  USER
  MODEL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}